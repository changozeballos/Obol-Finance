      "name": "Recibe el formulario",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 300],
      "webhookId": "obol-waitlist"
    },
    {
      "parameters": {
        "jsCode": "// El widget manda el JSON como text/plain para evitar el preflight CORS,\n// asi que el body puede llegar como objeto o como string. Contemplamos los dos casos.\nconst crudo = $input.first().json.body ?? $input.first().json;\nlet d;\ntry {\n  d = typeof crudo === 'string' ? JSON.parse(crudo) : crudo;\n} catch (e) {\n  d = {};\n}\n\nconst email = String(d.email || '').trim().toLowerCase();\nconst valido = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email);\n\n// Dominios descartables mas comunes\nconst descartables = ['mailinator.com', 'tempmail.com', 'guerrillamail.com', '10minutemail.com', 'yopmail.com'];\nconst dominio = email.split('@')[1] || '';\nconst esDescartable = descartables.includes(dominio);\n\nconst puntaje = Number.isFinite(Number(d.puntaje)) ? Number(d.puntaje) : null;\n\n// Segmento: sirve para escribirle distinto a cada grupo cuando lances\nlet segmento = 'sin_dato';\nif (puntaje !== null) {\n  if (puntaje <= 2) segmento = 'arranca_de_cero';\n  else if (puntaje <= 4) segmento = 'sabe_algo';\n  else segmento = 'ya_la_tiene_clara';\n}\n\nreturn [{\n  json: {\n    ok: valido && !esDescartable,\n    motivo: !valido ? 'email_invalido' : (esDescartable ? 'email_descartable' : ''),\n    email,\n    nombre: String(d.nombre || '').trim(),\n    puntaje,\n    total: d.total ?? null,\n    segmento,\n    origen: d.origen || 'desconocido',\n    pagina: d.pagina || '',\n    referrer: d.referrer || 'directo',\n    fecha: d.fecha || new Date().toISOString()\n  }\n}];"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Valida y segmenta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-140, 300]
    },
